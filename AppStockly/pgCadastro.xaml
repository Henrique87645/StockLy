<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AppStockly.pgCadastro"
             Shell.NavBarIsVisible="False"
             BackgroundColor="White">

    <ScrollView>

        <StackLayout VerticalOptions="Start"
                     HorizontalOptions="Fill">

            <!--
                Imagem decorativa do início da página.
            -->
            <Image x:Name="imgFundoSuperior"
                   Source="fundo.png"
                   HeightRequest="180"
                   HorizontalOptions="Fill"
                   VerticalOptions="Start"
                   Rotation="180"
                   Aspect="AspectFill"/>


            <!-- Conteúdo do cadastro -->
            <StackLayout HorizontalOptions="Center"
                         Padding="20,0,20,0">

                <Image Source="iconstockly.png"
                       HeightRequest="100"
                       HorizontalOptions="Center"
                       Margin="0,-10,0,0"/>

                <Label Text="Cadastro"
                       FontSize="30"
                       TextColor="Black"
                       HorizontalOptions="Center"
                       Margin="0,0,0,15"/>


                <Frame BackgroundColor="White"
                       BorderColor="Black"
                       WidthRequest="300">

                    <StackLayout>

                        <!-- Login Name -->
                        <Label Text="Login Name:"
                               TextColor="Black"
                               HorizontalTextAlignment="Start"/>

                        <Entry x:Name="txtUserName"
                               TextColor="Black"
                               ClearButtonVisibility="WhileEditing"/>

                        <Label x:Name="lblValidationUserName"
                               TextColor="#f34336"
                               FontSize="12"
                               IsVisible="False"/>


                        <!-- Nome -->
                        <Label Text="Nome:"
                               TextColor="Black"
                               HorizontalTextAlignment="Start"/>

                        <Entry x:Name="txtNome"
                               TextColor="Black"
                               ClearButtonVisibility="WhileEditing"/>

                        <Label x:Name="lblValidationNome"
                               TextColor="#f34336"
                               FontSize="12"
                               IsVisible="False"/>


                        <!-- CPF -->
                        <Label Text="CPF:"
                               TextColor="Black"
                               HorizontalTextAlignment="Start"/>

                        <Entry x:Name="txtCPF"
                               Keyboard="Numeric"
                               TextColor="Black"
                               ClearButtonVisibility="WhileEditing"/>

                        <Label x:Name="lblValidationCPF"
                               TextColor="#f34336"
                               FontSize="12"
                               IsVisible="False"/>


                        <!-- Email -->
                        <Label Text="E-mail:"
                               TextColor="Black"
                               HorizontalTextAlignment="Start"/>

                        <Entry x:Name="txtEmail"
                               Keyboard="Email"
                               TextColor="Black"
                               ClearButtonVisibility="WhileEditing"/>

                        <Label x:Name="lblValidationEmail"
                               TextColor="#f34336"
                               FontSize="12"
                               IsVisible="False"/>


                        <!-- Telefone -->
                        <Label Text="Telefone:"
                               TextColor="Black"
                               HorizontalTextAlignment="Start"/>

                        <Entry x:Name="txtTelefone"
                               Keyboard="Telephone"
                               TextColor="Black"
                               ClearButtonVisibility="WhileEditing"/>

                        <Label x:Name="lblValidationTelefone"
                               TextColor="#f34336"
                               FontSize="12"
                               IsVisible="False"/>


                        <!-- Possui empresa própria -->
                        <Label Text="Possui empresa própria?"
                               TextColor="Black"
                               HorizontalTextAlignment="Start"/>

                        <HorizontalStackLayout>

                            <RadioButton x:Name="rbEmpresaSim"
                                         Content="S"
                                         GroupName="Empresa"
                                         TextColor="Black"/>

                            <RadioButton x:Name="rbEmpresaNao"
                                         Content="N"
                                         GroupName="Empresa"
                                         TextColor="Black"/>

                        </HorizontalStackLayout>

                        <Label x:Name="lblValidationEmpresa"
                               TextColor="#f34336"
                               FontSize="12"
                               IsVisible="False"/>


                        <!-- Senha -->
                        <Label Text="Senha:"
                               TextColor="Black"
                               HorizontalTextAlignment="Start"/>

                        <Entry x:Name="txtSenha"
                               IsPassword="True"
                               TextColor="Black"
                               ClearButtonVisibility="WhileEditing"/>

                        <Label x:Name="lblValidationSenha"
                               TextColor="#f34336"
                               FontSize="12"
                               IsVisible="False"/>


                        <!-- Confirmar senha -->
                        <Label Text="Confirmar senha:"
                               TextColor="Black"
                               HorizontalTextAlignment="Start"/>

                        <Entry x:Name="txtConfirmarSenha"
                               IsPassword="True"
                               TextColor="Black"
                               ClearButtonVisibility="WhileEditing"/>

                        <Label x:Name="lblValidationConfirmarSenha"
                               TextColor="#f34336"
                               FontSize="12"
                               IsVisible="False"/>


                        <!-- Botões -->
                        <Button Text="Salvar"
                                TextColor="Black"
                                BackgroundColor="DeepSkyBlue"
                                Clicked="btnSalvar_Clicked"
                                Margin="0,10,0,0"/>

                        <Button Text="Voltar"
                                TextColor="Black"
                                BackgroundColor="LightGray"
                                Clicked="btnVoltar_Clicked"/>

                    </StackLayout>

                </Frame>

            </StackLayout>


            <!--
                Imagem decorativa do final da página.
            -->
            <Image x:Name="imgFundo"
                   Source="fundo.png"
                   HeightRequest="180"
                   HorizontalOptions="Fill"
                   VerticalOptions="End"
                   Aspect="AspectFill"
                   Margin="0,-10,0,0"/>

        </StackLayout>

    </ScrollView>

</ContentPage>