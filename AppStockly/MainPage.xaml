<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AppStockly.MainPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="White">
    
    <StackLayout VerticalOptions="Center">
        <Image x:Name="imgIconStockly" Source="iconstockly.png" HeightRequest="200" 
               HorizontalOptions="Center" VerticalOptions="Center" Margin="0,20,0,0"/>

        <Image x:Name="imgStockly" Source="stockly.png" HeightRequest="200" 
               HorizontalOptions="Center" VerticalOptions="Center"/>


        <Label Text="Carregando..." VerticalOptions="Center" HorizontalOptions="Center" FontSize="30" TextColor="Black"/>
        
        
        <Image x:Name="imgCarregar" Source="carregar.png" HeightRequest="50" 
               HorizontalOptions="Center" VerticalOptions="Center"/>

        <Image x:Name="imgFundo" Source="fundo.png" HeightRequest="250"
               HorizontalOptions="End" VerticalOptions="Center" />
    </StackLayout>
</ContentPage>
